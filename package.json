{
  "name": "wpasuj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r drizzle .next/standalone/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint"
  }
}
