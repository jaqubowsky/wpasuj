{
  "name": "wpasuj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r drizzle .next/standalone/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "duplicates": "jscpd",
    "semgrep": "docker run --rm -v \"$PWD:/src:ro\" -w /src semgrep/semgrep:1.177.0@sha256:acaac22ffc7b7cc5926de0751b223bce0b2491c33d18422fa72f632c78d81198 semgrep scan --config .semgrep --error --metrics=off --disable-version-check",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky",
    "perf": "playwright test -c playwright.perf.config.ts",
    "readme:shots": "npm run build && playwright test -c playwright.readme.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intersection-observer": "11.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "husky": "9.1.7",
    "jscpd": "5.3.2",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
